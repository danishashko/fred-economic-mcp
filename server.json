{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.danishashko/fred-economic-mcp",
  "description": "FRED economic data: GDP, inflation, unemployment, rates, and 800k+ Federal Reserve time series.",
  "title": "FRED Economic Data",
  "repository": {
    "url": "https://github.com/danishashko/fred-economic-mcp",
    "source": "github"
  },
  "version": "1.0.3",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "fred-economic-mcp",
      "version": "1.0.3",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "FRED_API_KEY",
          "description": "Free FRED API key from https://fredaccount.stlouisfed.org/apikeys",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}